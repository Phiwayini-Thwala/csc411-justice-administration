# Copy to .env or export these variables. Never commit real secrets.
# Must be the SAME value in police-service, judiciary-service and correctional-service (32+ characters).
JWT_SECRET=dev-only-shared-secret-change-me-32chars
CORRECTIONAL_URL=http://localhost:8003
JUDICIARY_DB_URL=sqlite:///./judiciary.db
# Demo users (court1, police1, correctional1, admin1) are created on first start.
SEED_DEMO_USERS=1
DEMO_PASSWORD=Passw0rd!
SEED_SAMPLE_CASES=1
