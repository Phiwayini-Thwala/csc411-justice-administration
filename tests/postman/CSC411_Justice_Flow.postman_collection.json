    {
      "name": "2 Correctional service",
      "description": "Admit, view, convict, transfer, release, audit",
      "item": [
        {
          "name": "Admit inmate on remand (court_officer)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"court_case\", \"CRT-T-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"inmate_id looks like INM-0000\", () => pm.expect(/^INM-\\d{4}$/.test(pm.response.json().inmate_id)).to.be.true);",
                  "pm.test(\"status is REMAND\", () => pm.expect(pm.response.json().status === \"REMAND\").to.be.true);",
                  "pm.collectionVariables.set(\"inmate_id\", pm.response.json().inmate_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tok_court}}"
              }
            ],
            "url": "{{correctional_url}}/inmates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"national_id\": \"8001015800083\",\n  \"full_name\": \"Sipho Dlamini\",\n  \"court_case_id\": \"{{court_case}}\",\n  \"admission_type\": \"REMAND\",\n  \"facility\": \"Matsapha Correctional Centre\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
